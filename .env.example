# Sugar Orbits now reads your personal G7 values from Dexcom Share.
# Use the same publisher credentials used by your Dexcom G7 app.
# Never commit this file or send its contents to anyone.
DEXCOM_SHARE_USERNAME=
DEXCOM_SHARE_PASSWORD=

# Germany and other countries outside the US/Japan use "ous".
DEXCOM_SHARE_REGION=ous

# Advanced alternative: use the account UUID instead of the username.
# Fill exactly one of USERNAME or ACCOUNT_ID, never both.
DEXCOM_SHARE_ACCOUNT_ID=

# Dexcom publishes approximately every five minutes.
DEXCOM_POLL_SECONDS=300

# On a hosted private copy, APP_BASE_URL is detected automatically.
APP_BASE_URL=http://127.0.0.1:8787

# Local-only by default.
HOST=127.0.0.1
PORT=8787

# Optional iPhone preview on the same trusted Wi-Fi network:
# HOST=0.0.0.0
# ALLOW_LAN_PREVIEW=true

# Required only for an internet-hosted private copy. Keep these private.
# APP_ACCESS_CODE is the code entered once on your iPhone.
APP_ACCESS_CODE=
APP_SESSION_SECRET=

# Rolling local glucose archive. Render uses /var/data from render.yaml.
DATA_DIR=.data

# Pi kiosk only. Enable with scripts/install-power-control.sh, not on hosted copies.
ALLOW_SYSTEM_SHUTDOWN=false
